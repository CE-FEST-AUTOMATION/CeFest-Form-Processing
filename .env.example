# Sample environment variables for local setup.
# Copy this file to .env and fill in real values.

# HTTP endpoint used by script.py, test.py, pastdata.py and onboarding.py
ENDPOINT="https://your-endpoint.example/submit"

# Excel export used by script.py and test.py
EXCEL_PATH="C:\\path\\to\\file.xlsx"

# Excel export used by pastdata.py
PAST_PATH="C:\\path\\to\\file.xlsx"

# CSV export used by onboarding.py
EXCO_PATH="C:\\path\\to\\file.csv"